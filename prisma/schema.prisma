generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  passwordHash       String
  name               String
  role               String            @default("BUYER") // BUYER, SELLER, ADMIN, DELIVERY_OFFICER
  phone              String?
  city               String?
  street             String?
  state              String?
  country            String?
  passportPhoto      String?           // Photo of user passport for KYC verification
  verificationStatus String            @default("NONE") // NONE, PENDING, VERIFIED, REJECTED
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  
  sellerProfile      SellerProfile?
  carts              Cart[]
  orders             Order[]           @relation("BuyerOrders")
  deliveries         Order[]           @relation("OfficerDeliveries")
  addresses          Address[]
  reviews            Review[]
  reviewedLoans      LoanApplication[] @relation("LoanReviewer")
}

model SellerProfile {
  id                 String            @id @default(uuid())
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  registrationNumber String            @unique
  businessAddress    String
  contactInfo        String
  passportPhoto      String?           // Seller passport verification document
  bankName           String            @default("Bank of Khartoum / Al Rajhi")
  bankAccountName    String            @default("JusurKush Merchant Account")
  bankAccountNumber  String            @default("1002-3849-5882")
  bankIBAN           String?           @default("SD12340000100238495882")
  status             String            @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  products           Product[]
  orderItems         OrderItem[]
  loanApplications   LoanApplication[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id          String        @id @default(uuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  name        String
  slug        String
  description String
  price       Float
  stock       Int           @default(0)
  images      String        // JSON array string of image URLs/paths
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]
}

model Cart {
  id           String     @id @default(uuid())
  userId       String?    
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  street     String
  city       String
  state      String
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Order {
  id                 String           @id @default(uuid())
  buyerId            String
  buyer              User             @relation("BuyerOrders", fields: [buyerId], references: [id])
  deliveryOfficerId  String?
  deliveryOfficer    User?            @relation("OfficerDeliveries", fields: [deliveryOfficerId], references: [id])
  totalAmount        Float
  status             String           @default("PENDING") // PENDING, PROOF_SUBMITTED, DISPATCHED, DELIVERED, CANCELLED
  shippingAddress    String           // JSON snapshot of shipping details
  paymentMethod      String           @default("bank_transfer")
  paymentProof       String?          // Image URL of bank transfer slip
  deliveryProofPhoto String?          // Evidence photo uploaded by Delivery Officer on delivery
  returnStatus       String           @default("NONE") // NONE, REQUESTED, APPROVED, REJECTED
  returnReason       String?
  returnComplaint    String?
  returnPhotos       String?          // JSON array string of return photos (min 6 required if no video)
  returnVideo        String?          // Return video URL
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  items              OrderItem[]
}

model OrderItem {
  id        String        @id @default(uuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id])
  price     Float
  quantity  Int
  review    Review?
}

model Review {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User      @relation(fields: [buyerId], references: [id])
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  rating      Int
  comment     String
  createdAt   DateTime  @default(now())
}

model LoanApplication {
  id              String        @id @default(uuid())
  sellerId        String
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  requestedAmount Float
  businessRevenue Float
  revenuePeriod   String
  loanPurpose     String
  supportingDocs  String        // JSON array of file paths
  status          String        @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewerNotes   String?
  submittedAt     DateTime      @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?         @relation("LoanReviewer", fields: [reviewedById], references: [id])
}
