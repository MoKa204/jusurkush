            {
              "id": "hm4hu63",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "Jusur Kush was founded to solve a major challenge faced by Sudanese creators: access to a stable, appreciative market. The traditional crafts of Sudan—rich in culture, meticulous design, and unique heritage—often struggle to find customers beyond local markets.",
                "text_color": "#333333",
                "align": "left",
                "typography_typography": "custom",
                "typography_font_family": "Inter",
                "typography_font_weight": "400"
              },
              "elements": []
            },
            {
              "id": "jgq6of2",
              "elType": "widget",
              "widgetType": "spacer",
              "settings": {
                "space": {
                  "unit": "px",
                  "size": "10"
                }
              },
              "elements": []
            },
            {
              "id": "yo0bz3h",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "By building a robust e-commerce bridge (Jusur), we seek to enable small-scale Sudanese workshops, independent designers, and skilled artisans to digitize their businesses, expand their visibility, and ensure their craft remains viable and preserved for generations.",
                "text_color": "#333333",
                "align": "left",
                "typography_typography": "custom",
                "typography_font_family": "Inter",
                "typography_font_weight": "400"
              },
              "elements": []
            }
          ]
        },
